---
// FRONT CONTROLLER: the one route file of the site.
// Every page is rendered here: inside SiteLayout (the frame), as a registered
// page type. Page types are wrapped by the shell (src/shell), which mounts the
// global elements. There is no other way for a page to exist.
//
// To add a page type: build it in src/page-types/<name>/ (default export =
// withShell(Component)), add its pages in its cluster under src/clusters/,
// add its type to SitePage in src/site/pages.ts, and add one branch below.
import SiteLayout from "../layouts/SiteLayout.astro";
import WaterfallPage from "../page-types/waterfall/index.tsx";
import MasterGuidePage from "../page-types/master-guide/index.tsx";
import LearnArticlePage from "../page-types/learn-article/index.tsx";
import ExperienceArticlePage from "../page-types/experience-article/index.tsx";
import CultureFeedPage from "../page-types/culture-feed/index.tsx";
import ObserveFeedPage from "../page-types/observe-feed/index.tsx";
import ActivityPage from "../page-types/activity/index.tsx";
import HomePage from "../page-types/home/index.tsx";
import CabinPage from "../page-types/cabin/index.tsx";
import HomeV2Page from "../page-types/home-v2/index.tsx";
import CabinV2Page from "../page-types/cabin-v2/index.tsx";
import ExploreHomePage from "../page-types/explore-home/index.tsx";
import ActivitiesHomePage from "../page-types/activities-home/index.tsx";
import PreviewIndex from "../page-types/preview-index/PreviewIndex.astro";
import { buildSitePages, PAGE_TYPES, type SitePage } from "../site/pages";

export async function getStaticPaths() {
	const pages = await buildSitePages();
	return pages.map((page) => ({
		params: { path: page.path === "" ? undefined : page.path },
		props: { page },
	}));
}

const { page } = Astro.props as { page: SitePage };
if (!(PAGE_TYPES as readonly string[]).includes(page.type)) {
	throw new Error(`No page type registered for "${(page as any).type}" (address "/${(page as any).path}").`);
}
---

<SiteLayout title={page.title} description={page.description}>
	{page.type === "waterfall" && <WaterfallPage client:load content={page.content} />}
	{page.type === "masterGuide" && <MasterGuidePage client:load content={page.content} />}
	{page.type === "learnArticle" && <LearnArticlePage client:load content={page.content} />}
	{page.type === "experienceArticle" && <ExperienceArticlePage client:load content={page.content} />}
	{page.type === "cultureFeed" && <CultureFeedPage client:load content={page.content} />}
	{page.type === "observeFeed" && <ObserveFeedPage client:load content={page.content} />}
	{page.type === "activity" && <ActivityPage client:load content={page.content} />}
	{page.type === "home" && <HomePage client:load content={page.content} />}
	{page.type === "cabin" && <CabinPage client:load content={page.content} />}
	{page.type === "homeV2" && <HomeV2Page client:load content={page.content} />}
	{page.type === "cabinV2" && <CabinV2Page client:load content={page.content} />}
	{page.type === "exploreHome" && <ExploreHomePage client:load content={page.content} />}
	{page.type === "activitiesHome" && <ActivitiesHomePage client:load content={page.content} />}
	{page.type === "previewIndex" && <PreviewIndex links={page.content.links} />}
</SiteLayout>
