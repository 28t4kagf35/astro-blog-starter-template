---
import SiteLayout from "../layouts/SiteLayout.astro";
// Comparison route: same Tvindefossen content, but images served via the
// on-the-fly Cloudflare Images transform (/img/[width]/[file]) instead of
// pre-baked static variants. This route is intentionally SSR (prerender =
// false) since the whole point is per-request transform -- it is NOT the
// measured Day 3 baseline (that stays static at /), it exists to Lighthouse
// this pipeline choice side by side with the static one.
export const prerender = false;

import TvindefossenApp from "../components/TvindefossenApp";
import type { WaterfallContent } from "../components/tvindefossen/TvindefossenFinal";
import {
  fetchTvindefossenDoc,
  buildDynamicImage,
  HERO_WIDTHS,
  HEADON_WIDTHS,
  CLOSE_WIDTHS,
  CLOSE_SIZES,
} from "../lib/tvindefossen";

const doc = await fetchTvindefossenDoc();

const heroImg = buildDynamicImage("hero", HERO_WIDTHS);
const headonImg = buildDynamicImage("headon", HEADON_WIDTHS);
const closeImg = buildDynamicImage("close", CLOSE_WIDTHS);

const content: WaterfallContent = {
  name: doc.name,
  tagline: doc.tagline,
  heroImage: heroImg.src,
  heroImageSrcSet: heroImg.srcSet,
  heroImageSizes: heroImg.sizes,
  heroImagePosition: doc.heroImagePosition,
  closeupPhoto: { src: closeImg.src, srcSet: closeImg.srcSet, sizes: CLOSE_SIZES, position: doc.closeupPhoto?.position },
  widePhoto: { src: headonImg.src, srcSet: headonImg.srcSet, sizes: headonImg.sizes, caption: doc.widePhoto?.caption },
  lede: doc.lede,
  spiceActive: doc.spiceActive,
  experiential: doc.experiential,
  practicalBody: doc.practicalBody,
  quickFacts: doc.quickFacts,
  planDetails: doc.planDetails,
  nextFall: {
    name: doc.nextFall?.name,
    descriptor: doc.nextFall?.descriptor,
    hero: { src: closeImg.src, srcSet: closeImg.srcSet, sizes: CLOSE_SIZES, position: doc.nextFall?.hero?.position },
  },
  continueCards: doc.continueCards,
  ambientAudio: {
    webm: "/audio/tvindefossen/tvinde-ambient.webm",
    mp4: "/audio/tvindefossen/tvinde-ambient.mp4",
  },
  location: { lng: 6.488368, lat: 60.725762 },
};

---

<SiteLayout title={`${content.name} — Voss Waterfalls (dynamic media)`} description={content.lede}>
	<TvindefossenApp client:load content={content} />
</SiteLayout>
