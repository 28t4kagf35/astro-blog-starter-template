---
// Waterfall detail pages: /explore/waterfalls/<slug> (sitemap v2).
// One static page per published `waterfall` document in Sanity, rendered
// through the finished detail component. Content is fetched at BUILD time;
// a Sanity edit needs a rebuild (deploy hook) to appear.
import TvindefossenApp from "../../../components/TvindefossenApp";
import { fetchAllWaterfalls, toContent } from "../../../lib/waterfalls";

export async function getStaticPaths() {
	const docs = await fetchAllWaterfalls();
	return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const content = toContent(doc);

const FONTS_HREF =
	"https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;1,8..60,300&family=Source+Sans+3:wght@300;400&family=IBM+Plex+Mono:wght@400&family=Raleway:wght@300;400&display=block";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{content.name} — Voss Waterfalls</title>
		<meta name="description" content={content.lede} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS_HREF} />
		<style is:global>
			html { background: #1A1714; }
			body { margin: 0; }
		</style>
	</head>
	<body>
		<TvindefossenApp client:load content={content} />
	</body>
</html>
