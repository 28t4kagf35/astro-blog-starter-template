---
import SiteLayout from "../layouts/SiteLayout.astro";
// Root placeholder. Home (sitemap v2 "/") is not built yet. Tvindefossen moved
// to its sitemap path /explore/waterfalls/tvindefossen on Sept 30.
// The list below is a preview convenience, built from Sanity at build time.
import { fetchAllWaterfalls } from "../lib/waterfalls";

const docs = await fetchAllWaterfalls();
---

<SiteLayout title={"Voss Waterfalls — preview"}>
	<style is:global>
			html { color: #C4BEB4; }
			body { font-family: system-ui, sans-serif; }
			main { max-width: 640px; margin: 0 auto; padding: 3rem 1.25rem; }
			h1 { color: #EDE9E2; font-weight: 300; font-size: 1.6rem; margin: 0 0 0.5rem; }
			p { margin: 0 0 2rem; font-size: 0.9rem; line-height: 1.6; }
			ul { list-style: none; padding: 0; margin: 0; }
			li { border-top: 1px solid #2C2A28; }
			a { display: block; padding: 0.9rem 0; color: #EDE9E2; text-decoration: none; }
			.mono { font-family: ui-monospace, monospace; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: #6E6A65; }
		</style>
	<main>
			<p class="mono">Home unavailable · preview build</p>
			<h1>Waterfalls</h1>
			<p>Home is not built yet. Waterfall pages:</p>
			<ul>
				<li><a href="/explore/waterfalls">Master Guide — Waterfalls of Voss</a></li>
				{docs.map((d) => (
					<li><a href={`/explore/waterfalls/${d.slug}`}>{d.name}</a></li>
				))}
			</ul>
		</main>
</SiteLayout>
